{
  "name": "dsh-balance-card",
  "description": "DeepSeek 余额卡片：在设置页顶部显示账户余额，一键跳转充值",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalvinQin/dsh-provider-balance-quota.git",
    "directory": "dsh-balance-card"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "balance",
    "plugin"
  ],
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7"
  },
  "license": "MIT"
}
