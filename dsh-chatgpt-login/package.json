{
  "name": "dsh-chatgpt-login",
  "description": "ChatGPT 登录与额度卡片：CodexManager 账号同步、侧边栏余额/额度展示、授权登录",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalvinQin/dsh-provider-balance-quota.git",
    "directory": "dsh-chatgpt-login"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "chatgpt",
    "codex",
    "quota",
    "oauth",
    "plugin"
  ],
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@earendil-works/pi-ai": "0.82.1"
  },
  "license": "MIT"
}
